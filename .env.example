# Configuracao local do banco MariaDB/MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=maos_app
DB_PASSWORD=coloque_sua_senha_aqui
DB_NAME=maos_que_ajudam
PORT=3000

# Gere um segredo aleatório com pelo menos 32 bytes (ex.: openssl rand -hex 32).
AUTH_SECRET=

# Origens frontend permitidas, separadas por vírgula. Vazio permite somente chamadas same-origin.
CORS_ORIGINS=http://localhost:5173
# Ative somente atrás de proxy HTTPS confiável.
TRUST_PROXY=0
ENABLE_HSTS=0
